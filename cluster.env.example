# Site settings for the launchers in paper/ and scripts/ (values already set in the
# environment win). Copy this file to
# cluster.env (git-ignored) and edit; scripts/env.sh sources it.

# Data root holding datasets/, checkpoints/, bset/ ... (layout: docs/DATA.md).
export STABLEWM_HOME=${STABLEWM_HOME:-/path/to/epcc_data}

# Python environment with this repository's dependencies installed
# (see README "Installation"). Leave empty to use the python already on PATH.
export VENV=${VENV:-}

# Environment module providing CUDA on Lmod clusters, e.g. cuda/12.9.1.
# Leave empty when the driver/toolkit is already available.
export CUDA_MODULE=${CUDA_MODULE:-}

# Slurm, only used by `paper/run_cell.sh --slurm` and `scripts/submit.sh`.
# SBATCH_ACCOUNT is read by sbatch itself. GPU jobs (launchers with #SBATCH --gres=gpu) get
# GPU_PARTITION / GPU_GRES, CPU-only jobs get CPU_PARTITION; empty means the cluster default.
# export SBATCH_ACCOUNT=my_account
# export GPU_PARTITION=gpu
# export GPU_GRES=gpu:1
# export CPU_PARTITION=cpu

# Weights & Biases is off by default; set online to log training runs.
export WANDB_MODE=${WANDB_MODE:-disabled}
